DATABASE_URL=postgres://nimplex:nimplex@localhost:5433/nimplex
PORT=8787

# BYOK 保險庫的主金鑰（openssl rand -base64 32）。沒設會用開發用固定金鑰並警告。
NIMPLEX_MASTER_KEY=

# 沙箱裡的 harness 打回閘道用的位址
NIMPLEX_PUBLIC_URL=http://localhost:8787
# NIMPLEX_GATEWAY_URL_DOCKER=http://host.docker.internal:8787

# docker sandbox 的預設 image（harness 多半是 npm CLI）
# NIMPLEX_DOCKER_IMAGE=node:22-bookworm-slim

# local sandbox 沒有隔離，預設關閉；只給開發用
# NIMPLEX_ALLOW_LOCAL_SANDBOX=1

# Better Auth（console 登入）的簽章 secret（openssl rand -base64 32）。沒設會用開發用固定值並警告。
BETTER_AUTH_SECRET=
# 允許打 /api/auth 的來源（逗號分隔）；預設含 console dev server 與 API 本體
# NIMPLEX_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8787

# ---- 社群登入（console 只提供 GitHub / Google）----
# API 啟動時會自動載入根目錄 .env；填好之後重啟 API 按鈕就會出現。
#
# GitHub：github.com/settings/developers → New OAuth App
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:8787/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
#
# Google：console.cloud.google.com → APIs & Services → Credentials → OAuth client ID（Web application）
#   Authorized JavaScript origins:  http://localhost:5173 與 http://localhost:8787
#   Authorized redirect URI:        http://localhost:8787/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 開發用後門：email + password 註冊/登入（e2e 冒煙腳本要用）。正式環境不要開。
# NIMPLEX_DEV_EMAIL_AUTH=1

# ---- 遠端 sandbox：E2B（插槽 3 的第一家雲）----
# 設了 key 之後 /v1/sandbox-providers 的 e2b 會變成 available；run 用 sandbox.provider=e2b
# 遠端沙箱要打回閘道，NIMPLEX_PUBLIC_URL 必須是 E2B 雲端連得到的位址（本機開發要開 tunnel）
# E2B_API_KEY=
# NIMPLEX_E2B_TEMPLATE=            # 預設 template；run 的 sandbox.image 可覆寫
# NIMPLEX_E2B_LIFETIME_MS=3600000  # sandbox 壽命上限；Hobby 方案最多 1 小時（Pro 24h），run 結束時 worker 本來就會刪

# ---- 長尾 sandbox：透過 ComputeSDK adapter（packages/sandbox/src/computesdk.ts）----
# DAYTONA_API_KEY=
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
