DATABASE_URL=postgres://nimplex:nimplex@localhost:5433/nimplex
PORT=8787

# Master key for the BYOK vault (openssl rand -base64 32). Unset = fixed dev key with a warning.
NIMPLEX_MASTER_KEY=

# Public URL of the API (Better Auth callbacks).
NIMPLEX_PUBLIC_URL=http://localhost:8787

# Default docker sandbox image.
# NIMPLEX_DOCKER_IMAGE=node:22-bookworm-slim

# The local sandbox has no isolation and is off by default; dev only.
# NIMPLEX_ALLOW_LOCAL_SANDBOX=1

# Better Auth signing secret (openssl rand -base64 32). Unset = fixed dev value with a warning.
BETTER_AUTH_SECRET=
# Origins allowed to call /api/auth (comma separated).
# NIMPLEX_TRUSTED_ORIGINS=http://localhost:8787

# ---- Social login (GitHub / Google) ----
# The API loads this file at startup; fill these in and restart.
#
# GitHub: github.com/settings/developers -> New OAuth App
#   Authorization callback URL: http://localhost:8787/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
#
# Google: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web application)
#   Authorized redirect URI: http://localhost:8787/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dev backdoor: email + password sign-up/login (the e2e smoke test needs it). Never enable in prod.
# NIMPLEX_DEV_EMAIL_AUTH=1

# ---- Remote sandbox: E2B ----
# With a key set, /v1/sandbox-providers reports e2b as available; runs use sandbox.provider=e2b.
# E2B_API_KEY=
# NIMPLEX_E2B_TEMPLATE=            # default template; sandbox.image on a run overrides it
# NIMPLEX_E2B_LIFETIME_MS=3600000  # sandbox lifetime cap; Hobby plan max 1h (Pro 24h); the worker deletes it at run end anyway

# ---- Long-tail sandboxes via the ComputeSDK adapter (packages/sandbox/src/computesdk.ts) ----
# DAYTONA_API_KEY=
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=

# ---- Harness execution ----
# NIMPLEX_LEASE_SECONDS=60       # worker lease; heartbeat checks cancellation at most every second
# NIMPLEX_CONTEXT_CHARS=64000    # context checkpoint threshold; originals stay in the durable log
# NIMPLEX_TEST_POSTGRES_URL=postgres://nimplex:nimplex@localhost:5433/postgres
# pnpm e2e creates and drops its own database on this PostgreSQL server.
