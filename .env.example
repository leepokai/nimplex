DATABASE_URL=postgres://nimplex:nimplex@localhost:5433/nimplex
PORT=8787

# BYOK 保險庫的主金鑰（openssl rand -base64 32）。沒設會用開發用固定金鑰並警告。
NIMPLEX_MASTER_KEY=

# 沙箱裡的 harness 打回閘道用的位址
NIMPLEX_PUBLIC_URL=http://localhost:8787
# NIMPLEX_GATEWAY_URL_DOCKER=http://host.docker.internal:8787

# docker sandbox 的預設 image（harness 多半是 npm CLI）
# NIMPLEX_DOCKER_IMAGE=node:22-bookworm-slim

# local sandbox 沒有隔離，預設關閉；只給開發用
# NIMPLEX_ALLOW_LOCAL_SANDBOX=1
