# Loaded by the nimplex CLI from the current project. Tools never inherit these values.

# Model credential (or run `nimplex login`). ANTHROPIC_BASE_URL selects a compatible endpoint.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# Native commands run in a sandbox; just-bash-only tasks create none.
# E2B_API_KEY=
# NIMPLEX_E2B_TEMPLATE=            # default template; --sandbox docker uses NIMPLEX_DOCKER_IMAGE instead
# NIMPLEX_E2B_LIFETIME_MS=3600000  # sandbox lifetime cap; Hobby plan max 1h
# NIMPLEX_DOCKER_IMAGE=node:22-bookworm-slim

# Long-tail sandboxes through the ComputeSDK adapter (packages/sandbox/src/computesdk.ts).
# DAYTONA_API_KEY=
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=

# Execution engine for new sessions: pi-harness (default) or the legacy pi-executor.
# NIMPLEX_ENGINE=pi-executor
# NIMPLEX_STATE_DIR=               # local state root; default ~/.local/state/nimplex/<project-hash>
# NIMPLEX_CONTEXT_CHARS=64000      # context checkpoint threshold; originals stay in the durable log
