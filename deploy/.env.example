# Goes to /opt/nimplex/.env on the VPS (gitignored). Compose reads this file.

# ---- Public address ----
# Subdomain convention: dev uses api-dev.nimplex.dev, prod uses api.nimplex.dev
# (single-level subdomains so a wildcard certificate covers them).
# With a domain:    SITE_ADDRESS=api-dev.nimplex.dev (Caddy auto TLS), NIMPLEX_PUBLIC_URL=https://api-dev.nimplex.dev
# Without a domain: SITE_ADDRESS=:80, NIMPLEX_PUBLIC_URL=http://<ip>
SITE_ADDRESS=api-dev.nimplex.dev
NIMPLEX_PUBLIC_URL=https://api-dev.nimplex.dev
NIMPLEX_TRUSTED_ORIGINS=https://api-dev.nimplex.dev

# ---- Secrets: generate fresh values for every environment, never reuse local ones ----
# openssl rand -base64 32
NIMPLEX_MASTER_KEY=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# openssl rand -hex 16
POSTGRES_PASSWORD=

# ---- Login ----
# Dev environments enable the email/password backdoor. Anyone who finds the URL can sign up and
# start sandboxes on the E2B key below, so keep the URL private and turn this off in production.
NIMPLEX_DEV_EMAIL_AUTH=1
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---- Slot 3: remote sandboxes (the worker container has no docker daemon, so only remote providers work) ----
E2B_API_KEY=
# NIMPLEX_E2B_TEMPLATE=

# ---- Images ----
# Tag pushed to GHCR by GitHub Actions; for manual deploys you can pin a commit SHA.
IMAGE_TAG=latest
